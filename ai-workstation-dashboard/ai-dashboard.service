[Unit]
Description=AI Workstation Dashboard
After=network.target

[Service]
Type=simple
User=mozarcik
Group=mozarcik
WorkingDirectory=/home/mozarcik/ai-dashboard
ExecStart=/home/mozarcik/ai-dashboard/start.sh
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

# Read by backend/server.py and start.sh (defaults: 0.0.0.0:8666)
Environment=DASHBOARD_PORT=8666

[Install]
WantedBy=multi-user.target
